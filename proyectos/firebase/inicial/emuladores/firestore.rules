rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/notas/{nota} {
      function propietario() { return request.auth != null && request.auth.uid == uid; }
      allow read, delete: if propietario();
      allow create, update: if propietario()
        && request.resource.data.keys().hasOnly(['titulo'])
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 3
        && request.resource.data.titulo.size() <= 80;
    }
  }
}