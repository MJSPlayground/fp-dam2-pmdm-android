rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /usuarios/{uid}/imagen {
      function propietario() { return request.auth != null && request.auth.uid == uid; }
      allow read, delete: if propietario();
      allow create, update: if propietario()
        && request.resource.size > 0 && request.resource.size <= 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg)');
    }
  }
}